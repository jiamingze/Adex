{
  "appId": "io.adex.personal",
  "appName": "Adex",
  "webDir": "web-dist",
  "ios": {
    "contentInset": "never",
    "scrollEnabled": false
  },
  "server": {
    "allowNavigation": []
  },
  "plugins": {
    "Camera": {
      "presentationStyle": "popover"
    },
    "CapacitorHttp": {
      "enabled": true
    },
    "Keyboard": {
      "resize": "native",
      "resizeOnFullScreen": true
    }
  }
}
