# Run python3 scripts/init_env.py to generate private local credentials.
ADEX_OWNER_USERNAME=owner
ADEX_OWNER_PASSWORD=replace-with-at-least-12-characters
ADEX_ADMIN_PASSWORD=replace-with-random-password
ADEX_PG_HOST=127.0.0.1
ADEX_PG_PORT=55432
ADEX_PG_DB=adex_dev
ADEX_REDIS_URL=redis://127.0.0.1:56379/0
ADEX_APP_URL=http://127.0.0.1:8080
ADEX_AUTOMATION_URL=http://127.0.0.1:8081
ADEX_AGENT_URL=http://127.0.0.1:8105
ADEX_TOOLS_URL=http://127.0.0.1:8107
ADEX_APP_KEY=generate-distinct-random-key-at-least-32-characters
ADEX_AUTOMATION_KEY=generate-distinct-random-key-at-least-32-characters
ADEX_AGENT_KEY=generate-distinct-random-key-at-least-32-characters
ADEX_TOOLS_KEY=generate-distinct-random-key-at-least-32-characters
ADEX_APP_DB_PASSWORD=replace-with-random-password
ADEX_AUTOMATION_DB_PASSWORD=replace-with-random-password
ADEX_AGENT_DB_PASSWORD=replace-with-random-password
ADEX_TOOLS_DB_PASSWORD=replace-with-random-password
# Opt-in Codex text backend: currently requires ADEX_MODEL_PROVIDER=qwen.
ADEX_EXECUTION_ENGINE=direct
# Absolute installed app-server path when engine=codex; never a public socket.
ADEX_CODEX_BINARY=
ADEX_MODEL_PROVIDER=minimax
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M2.5
MINIMAX_API_KEY=
ADEX_MAX_OUTPUT_TOKENS=4096
ADEX_BACKGROUND_WORKER=true
ADEX_FILE_STORAGE_ROOT=/data/adex/files

TAVILY_API_KEY=
ADEX_CALDAV_URL=
ADEX_CALDAV_USERNAME=
ADEX_CALDAV_PASSWORD=
ADEX_SMTP_HOST=
ADEX_SMTP_PORT=587
ADEX_SMTP_USERNAME=
ADEX_SMTP_PASSWORD=
ADEX_SMTP_FROM=
ADEX_ALLOWED_ORIGINS=capacitor://localhost
ADEX_CODE_RUNNER_MODE=disabled
ADEX_CODE_RUNNER_IMAGE=adex-code-runner:local
ADEX_MEDIA_WEBHOOK_SECRET=
ADEX_CALDAV_OWNER_ID=
ADEX_VISION_PROVIDER=disabled
ADEX_VISION_API_KEY=
# Native builds point to the externally configured TLS App gateway.
VITE_ADEX_API_BASE=
ADEX_CODE_RUNNER_TEMP_ROOT=.local-data/runner-tmp
# Add the actual HTTPS public origin at deployment; no wildcard origins.
ADEX_ALLOWED_ORIGINS=capacitor://localhost
# Optional deployment-specific price estimates; provider invoices remain authoritative.
ADEX_PRICE_INPUT_PER_MILLION=
ADEX_PRICE_OUTPUT_PER_MILLION=
ADEX_PRICE_CURRENCY=CNY
# Optional isolated Runner gateway (separate from Tools; never exposes Docker socket publicly).
ADEX_RUNNER_KEY=
ADEX_CODE_RUNNER_URL=
ADEX_RUNNER_HOST_DIR=
ADEX_DOCKER_GID=0
# Original music: Tools-only credential, separate from text model access.
ADEX_MUSIC_PROVIDER=mock
ADEX_MUSIC_API_KEY=
ADEX_MUSIC_BASE_URL=https://api.minimaxi.com/v1
ADEX_MUSIC_MODEL=music-3.0
# Required true behind production HTTPS; false only on loopback development.
ADEX_COOKIE_SECURE=false

# Optional loopback-only ACE-Step original instrumental music runner
ADEX_ACESTEP_URL=http://127.0.0.1:8001

# Alibaba Cloud Beijing: text / original music / async video
DASHSCOPE_API_KEY=
DASHSCOPE_CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_CHAT_MODEL=qwen3.8-flash
DASHSCOPE_MEDIA_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_MUSIC_MODEL=qwen-audio-3.1-tts-next
DASHSCOPE_VIDEO_MODEL=wan3.0-video
ADEX_VIDEO_PROVIDER=mock

# Per-owner real media requests per day; long compositions count as one bounded request.
ADEX_MEDIA_DAILY_LIMIT=5

# Explicit local model budget and image generation
# Set 0 for unlimited chat replies; usage is still recorded.
ADEX_DAILY_MODEL_CALL_LIMIT=50
ADEX_IMAGE_PROVIDER=dashscope
DASHSCOPE_IMAGE_MODEL=qwen-image-3.0

# Google connectors: absent credentials yield BLOCKED_EXTERNAL.
# Use a Web OAuth client, exact HTTPS redirect and your own verified consent screen.
ADEX_GOOGLE_CLIENT_ID=
ADEX_GOOGLE_CLIENT_SECRET=
ADEX_GOOGLE_REDIRECT_URI=
ADEX_PUBLIC_WEB_URL=http://127.0.0.1:5173
# Base64 32 random bytes; generate privately, persist securely, never change without re-encryption.
ADEX_CONNECTOR_ENCRYPTION_KEY=
# APNs requires an eligible Apple team/profile and private .p8 outside Git.
ADEX_APNS_KEY_FILE=
ADEX_APNS_KEY_ID=
ADEX_APNS_TEAM_ID=
ADEX_APNS_TOPIC=io.adex.personal
ADEX_APNS_DEVICE_ENCRYPTION_KEY=

# Public HTTPS browser reads; use allowlist to restrict destinations to exact hosts.
# Full bundled Chromium; set chrome only when installed and deliberately selected.
ADEX_BROWSER_CHANNEL=chromium
# Optional trusted local HTTP proxy. Targets still use validated pinned public IPs.
ADEX_BROWSER_UPSTREAM_PROXY=
ADEX_BROWSER_MODE=public
ADEX_BROWSER_ALLOWED_HOSTS=github.com,raw.githubusercontent.com,github.githubassets.com,avatars.githubusercontent.com

# 32-byte base64 encryption key for browser login state; never commit a real key.
ADEX_BROWSER_ENCRYPTION_KEY=

# Permit direct connection to the same validated IP only if local proxy CONNECT fails.
ADEX_BROWSER_DIRECT_FALLBACK=0

# Optional owner-bound macOS runner. Disabled on shared/ECS installs.
ADEX_COMPUTER_ENABLED=false
# all_installed requires explicit local owner consent; default retains per-app grants.
ADEX_COMPUTER_APP_POLICY=allowlist
ADEX_COMPUTER_OWNER_ID=
ADEX_COMPUTER_HOST_ID=local-mac
ADEX_COMPUTER_RUNNER=
# Explicit document roots for returning files to this owner; path-separator delimited.
ADEX_COMPUTER_FILE_ROOTS=
ADEX_COMPUTER_APPS=计算器=com.apple.calculator,Calculator=com.apple.calculator,文本编辑=com.apple.TextEdit,TextEdit=com.apple.TextEdit,Chrome=com.google.Chrome,Google Chrome=com.google.Chrome,谷歌浏览器=com.google.Chrome,Chrome浏览器=com.google.Chrome

# Server-side Alibaba realtime ASR (DASHSCOPE_API_KEY stays in Tools)
ADEX_ASR_MODEL=qwen3-asr-flash-realtime
ADEX_ASR_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
