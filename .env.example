# Run python3 scripts/init_env.py to generate private local credentials.
ADEX_OWNER_USERNAME=owner
ADEX_OWNER_PASSWORD=replace-with-at-least-12-characters
ADEX_ADMIN_PASSWORD=replace-with-random-password
ADEX_PG_HOST=127.0.0.1
ADEX_PG_PORT=55432
ADEX_PG_DB=adex_dev
ADEX_REDIS_URL=redis://127.0.0.1:56379/0
ADEX_APP_URL=http://127.0.0.1:8080
ADEX_AUTOMATION_URL=http://127.0.0.1:8081
ADEX_AGENT_URL=http://127.0.0.1:8105
ADEX_TOOLS_URL=http://127.0.0.1:8107
ADEX_APP_KEY=generate-distinct-random-key-at-least-32-characters
ADEX_AUTOMATION_KEY=generate-distinct-random-key-at-least-32-characters
ADEX_AGENT_KEY=generate-distinct-random-key-at-least-32-characters
ADEX_TOOLS_KEY=generate-distinct-random-key-at-least-32-characters
ADEX_APP_DB_PASSWORD=replace-with-random-password
ADEX_AUTOMATION_DB_PASSWORD=replace-with-random-password
ADEX_AGENT_DB_PASSWORD=replace-with-random-password
ADEX_TOOLS_DB_PASSWORD=replace-with-random-password
ADEX_MODEL_PROVIDER=minimax
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M2.5
MINIMAX_API_KEY=
ADEX_MAX_OUTPUT_TOKENS=4096
ADEX_BACKGROUND_WORKER=true
ADEX_FILE_STORAGE_ROOT=/data/adex/files

TAVILY_API_KEY=
ADEX_CALDAV_URL=
ADEX_CALDAV_USERNAME=
ADEX_CALDAV_PASSWORD=
ADEX_SMTP_HOST=
ADEX_SMTP_PORT=587
ADEX_SMTP_USERNAME=
ADEX_SMTP_PASSWORD=
ADEX_SMTP_FROM=
ADEX_ALLOWED_ORIGINS=capacitor://localhost
ADEX_CODE_RUNNER_MODE=disabled
ADEX_CODE_RUNNER_IMAGE=adex-code-runner:local
ADEX_MEDIA_WEBHOOK_SECRET=
ADEX_CALDAV_OWNER_ID=
ADEX_VISION_PROVIDER=disabled
ADEX_VISION_API_KEY=
# Native builds point to the externally configured TLS App gateway.
VITE_ADEX_API_BASE=
ADEX_CODE_RUNNER_TEMP_ROOT=.local-data/runner-tmp
# Add the actual HTTPS public origin at deployment; no wildcard origins.
ADEX_ALLOWED_ORIGINS=capacitor://localhost
# Optional deployment-specific price estimates; provider invoices remain authoritative.
ADEX_PRICE_INPUT_PER_MILLION=
ADEX_PRICE_OUTPUT_PER_MILLION=
ADEX_PRICE_CURRENCY=CNY
# Optional isolated Runner gateway (separate from Tools; never exposes Docker socket publicly).
ADEX_RUNNER_KEY=
ADEX_CODE_RUNNER_URL=
ADEX_RUNNER_HOST_DIR=
ADEX_DOCKER_GID=0
# Original music: Tools-only credential, separate from text model access.
ADEX_MUSIC_PROVIDER=mock
ADEX_MUSIC_API_KEY=
ADEX_MUSIC_BASE_URL=https://api.minimaxi.com/v1
ADEX_MUSIC_MODEL=music-3.0
# Required true behind production HTTPS; false only on loopback development.
ADEX_COOKIE_SECURE=false

# Optional loopback-only ACE-Step original instrumental music runner
ADEX_ACESTEP_URL=http://127.0.0.1:8001

# Alibaba Cloud Beijing: text / original music / async video
DASHSCOPE_API_KEY=
DASHSCOPE_CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_CHAT_MODEL=qwen3.8-max
DASHSCOPE_MEDIA_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_MUSIC_MODEL=qwen-audio-3.1-tts-next
DASHSCOPE_VIDEO_MODEL=wan3.0-video
ADEX_VIDEO_PROVIDER=mock

# Per-owner real media requests per day; long compositions count as one bounded request.
ADEX_MEDIA_DAILY_LIMIT=5
